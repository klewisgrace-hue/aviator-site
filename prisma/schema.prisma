generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DiamondTransactionType {
  PURCHASE
  ADMIN_ADD
  ADMIN_REMOVE
  ANALYSIS_USAGE
  REFUND
  BONUS
  ADJUSTMENT
}

model User {
  id             String        @id @default(cuid())
  fullName       String
  username       String        @unique
  email          String        @unique
  phone          String?
  passwordHash   String
  role           Role          @default(USER)
  status         AccountStatus @default(PENDING)
  diamondBalance Int           @default(0)
  partnerCode    String?       @unique
  isPartner      Boolean       @default(false)
  commissionRate Int           @default(20)
  referredById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       Payment[]
  diamondTransactions DiamondTransaction[]
  analyses       Analysis[]
  notifications  Notification[]
  auditLogs      AuditLog[]    @relation("AdminActions")
  referredBy     User?         @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]        @relation("Referrals")
  partnerEarnings PartnerEarning[]
}

model PartnerEarning {
  id        String   @id @default(cuid())
  partnerId String
  paymentId String?
  amount    Decimal  @db.Decimal(12, 2)
  percent   Int
  source    String
  createdAt DateTime @default(now())
  partner   User     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}


model Package {
  id            String   @id @default(cuid())
  name          String
  diamonds      Int
  price         Decimal  @db.Decimal(12, 2)
  currency      String   @default("GHS")
  analysesCount Int
  description   String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  packageId     String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("GHS")
  reference     String        @unique
  phoneUsed     String?
  proofImage    String?       @db.Text
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       Package?      @relation(fields: [packageId], references: [id])
}

model DiamondTransaction {
  id            String                 @id @default(cuid())
  userId        String
  type          DiamondTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  description   String?
  createdAt     DateTime               @default(now())
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                 String   @id @default(cuid())
  userId             String
  inputData          Json
  statisticalResults Json
  aiResponse         String?  @db.Text
  creditsUsed        Int
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActions", fields: [adminId], references: [id])
}